# Neon Postgres connection string
# Get it from https://console.neon.tech → your project → Connect
# Use the pooled ("-pooler") host for serverless deployments.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to sign session JWTs.
# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# Account that `npm run stripe:provision` is allowed to write to.
STRIPE_ACCT_ID=acct_your_account_id
